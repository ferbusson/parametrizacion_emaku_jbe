<FORM>
  <preferences>
    <size width="400" height="190" />
    <name>Gernera Soportes Nómina Electrónica - Por Fecha y Tercero</name>
    <icon>REPORT</icon>
    <iconificable />
    <resizable />
    <closable />
    <closable />
  </preferences>
  <panel locate="North" type="FlowLayout" />
  <panel locate="West" type="FlowLayout" />
  <panel locate="East" type="FlowLayout" />
  <panel locate="Center" type="BorderLayout">
    <panel locate="West" type="GridLayout" rows="3" cols="1">
      <component>
        <driver>common.gui.components.XMLLabel</driver>
        <parameters>
          <arg attribute="text">Fecha Inicial</arg>
        </parameters>
      </component>
      <component>
        <driver>common.gui.components.XMLLabel</driver>
        <parameters>
          <arg attribute="text">Fecha Final</arg>
        </parameters>
      </component>
      <component>
        <driver>common.gui.components.XMLLabel</driver>
        <parameters>
          <arg attribute="text">Tercero</arg>
        </parameters>
      </component>      
    </panel>
    <panel locate="Center" type="GridLayout" rows="3" cols="1">
      <component>
        <driver id="fechai">common.gui.components.XMLDateField</driver>
        <parameters>
          <arg attribute="exportValue">fechai</arg>
        </parameters>
      </component>
      <component>
        <driver id="fechaf">common.gui.components.XMLDateField</driver>
        <parameters>
          <arg attribute="exportValue">fechaf</arg>
        </parameters>
      </component>
      <component>
        <driver id="idt">client.gui.components.EmakuSearchField</driver>
        <parameters>
          <arg attribute="size">18</arg>
          <arg attribute="maxlength">26</arg>
          <arg attribute="nullValue">false</arg>
          <arg attribute="returnNullValue">false</arg>
          <arg attribute="exportValue">idt</arg>
          <arg attribute="format">TEXT</arg>
          <arg attribute="sqlCombo">SEL0324</arg>
          <arg attribute="blankArgs">false</arg>
          <arg attribute="keyDataSearch">searchProd</arg>
          <arg attribute="repeatData">2</arg>
          <arg attribute="noDataBeep">true</arg>
          <arg attribute="noDataMessage">No se encontro registros</arg>
          <arg attribute="selectedIndex">1</arg>
          <arg attribute="enabled">true</arg>
          <arg attribute="clean">true</arg>
        </parameters>
      </component>      
    </panel>
  </panel>
  <component locate="South">
    <driver>common.gui.components.ButtonsPanel</driver>
    <parameters>
      <!-- <subarg>
        <arg attribute="label">EXCEL</arg>
        <arg attribute="icon">/icons/ico_excel.png</arg>
        <arg attribute="keyStroke">F9</arg>
        <arg attribute="typePackage">XLSREPORTREQUEST</arg>
        <arg attribute="idReport">XLS0060</arg>
      </subarg>       -->
      <subarg>
            <arg attribute="label">REPORT</arg>
            <arg attribute="icon">REPORT</arg>
            <arg attribute="keyStroke">F9</arg>
            <arg attribute="typePackage">REPORTREQUEST</arg>
            <arg attribute="idReport">CRE0230</arg>
      </subarg>
      <arg>NEW</arg>
      <arg>EXIT</arg>
    </parameters>
    <events>
      <object>
        <name>NEW</name>
        
        <component>
          <driver>common.gui.components.ButtonsPanel</driver>
          <method>setEnabled</method>
          <parameters>
            <arg attribute="button">EXCEL</arg>
            <arg attribute="state">TRUE</arg>
          </parameters>
        </component>            

        <component>
          <driver>this</driver>
          <method>cleanExternalValues</method>
        </component>        
        <component>
          <driver id="fechai">common.gui.components.XMLDateField</driver>
          <method>clean</method>
        </component>
        <component>
          <driver id="fechaf">common.gui.components.XMLDateField</driver>
          <method>clean</method>
        </component>
        <component>
          <driver id="idt">client.gui.components.EmakuSearchField</driver>
          <method>clean</method>
        </component>
        <component>
          <driver id="incluirqr">client.gui.components.XMLCheckBox</driver>
          <method>clean</method>
        </component>
        
      </object>
      <!-- <object>
        <name>EXCEL</name>
        <component>
          <driver>this</driver>
          <method>getPackage</method>
          <parameters>
            <arg attribute="nullField">true</arg>
            <arg attribute="blankPackage">true</arg>
            <subarg>
              <arg attribute="importValue">fechai</arg>
              <arg attribute="importValue">fechaf</arg>              
              <arg attribute="importValue">idt</arg>
              <arg attribute="importValue">documento</arg>
            </subarg>
          </parameters>
        </component>
        <component>
          <driver>common.gui.components.ButtonsPanel</driver>
          <method>setEnabled</method>
          <parameters>
            <arg attribute="button">EXCEL</arg>
            <arg attribute="state">TRUE</arg>
          </parameters>
        </component>            

      </object> -->
      <object>
            <name>REPORT</name>
            <component>
              <driver>this</driver>
              <method>getPackage</method>
              <parameters>
                <arg attribute="nullField">true</arg>
                <arg attribute="blankPackage">true</arg>
                <subarg>
                  <arg attribute="importValue">fechai</arg>
                  <arg attribute="importValue">fechaf</arg>              
                  <arg attribute="importValue">idt</arg>
                </subarg>
              </parameters>
            </component>
          </object>
    </events>
  </component>
</FORM>