<FORM>
    <preferences>
        <size width="370" height="250" />
        <name>Detallado Auxiliares por Cuenta</name>
        <icon>REPORT</icon>
        <iconificable />
        <resizable />
        <closable />
    </preferences>
    <panel locate="North" type="FlowLayout" />
    <panel locate="West" type="FlowLayout" />
    <panel locate="East" type="FlowLayout" />
    <panel locate="Center" type="BorderLayout">
        <panel locate="West" type="GridLayout" rows="5" cols="1">
            <component>
                <driver>common.gui.components.XMLLabel</driver>
                <parameters>
                    <arg attribute="text">FECHAI</arg>
                </parameters>
            </component>
            <component>
                <driver>common.gui.components.XMLLabel</driver>
                <parameters>
                    <arg attribute="text">FECHAF</arg>
                </parameters>
            </component>
            <component>
                <driver>common.gui.components.XMLLabel</driver>
                <parameters>
                    <arg attribute="text">Cuenta Inicial</arg>
                </parameters>
            </component>
            <component>
                <driver>common.gui.components.XMLLabel</driver>
                <parameters>
                    <arg attribute="text">Cuenta Final</arg>
                </parameters>
            </component>
            <component>
                <driver>common.gui.components.XMLLabel</driver>
                <parameters>
                    <arg attribute="text">Centro Costo</arg>
                </parameters>
            </component>
        </panel>
        <panel locate="Center" type="GridLayout" rows="5" cols="1">
            <component>
                <driver id="fechai">common.gui.components.XMLDateField</driver>
                <parameters>
                    <arg attribute="exportValue">fechai</arg>
                </parameters>
            </component>
            <component>
                <driver id="fechaf">common.gui.components.XMLDateField</driver>
                <parameters>
                    <arg attribute="exportValue">fechaf</arg>
                </parameters>
            </component>
            <component>
                <driver id="idcta">client.gui.components.EmakuSearchField</driver>
                <parameters>
                    <arg attribute="size">18</arg>
                    <arg attribute="maxlength">26</arg>
                    <arg attribute="nullValue">true</arg>
                    <arg attribute="exportValue">idcta</arg>
                    <arg attribute="format">TEXT</arg>
                    <arg attribute="sqlCombo">SEL0323</arg>
                    <arg attribute="blankArgs">false</arg>
                    <arg attribute="keyDataSearch">searchProd</arg>
                    <arg attribute="repeatData">2</arg>
                    <arg attribute="noDataBeep">true</arg>
                    <arg attribute="noDataMessage">No se encontro registros</arg>
                    <arg attribute="selectedIndex">1</arg>
                    <arg attribute="enabled">true</arg>
                    <arg attribute="clean">true</arg>
                </parameters>
            </component>
            <component>
                <driver id="idctafinal">client.gui.components.EmakuSearchField</driver>
                <parameters>
                    <arg attribute="size">18</arg>
                    <arg attribute="maxlength">26</arg>
                    <arg attribute="nullValue">true</arg>
                    <arg attribute="exportValue">idctafinal</arg>
                    <arg attribute="format">TEXT</arg>
                    <arg attribute="sqlCombo">SEL0323</arg>
                    <arg attribute="blankArgs">false</arg>
                    <arg attribute="keyDataSearch">searchProd</arg>
                    <arg attribute="repeatData">2</arg>
                    <arg attribute="noDataBeep">true</arg>
                    <arg attribute="noDataMessage">No se encontro registros</arg>
                    <arg attribute="selectedIndex">1</arg>
                    <arg attribute="enabled">true</arg>
                    <arg attribute="clean">true</arg>
                </parameters>
            </component>
            <component>
        <driver id="centro">client.gui.components.XMLComboBox</driver>
        <parameters>
          <arg attribute="sqlCombo">LCSEL0074</arg>
          <arg attribute="nameField">centrocosto</arg>
          <arg attribute="preferredLength">200</arg>
          <arg attribute="addAttribute">key</arg>
          <arg attribute="nullValue">true</arg>
          <arg attribute="exportValue">centro</arg>
        </parameters>
      </component>
        </panel>
    </panel>
    <component locate="South">
        <driver>common.gui.components.ButtonsPanel</driver>
        <parameters>
            <subarg>
                <arg attribute="label">REPORT</arg>
                <arg attribute="icon">REPORT</arg>
                <arg attribute="keyStroke">F9</arg>
                <arg attribute="typePackage">REPORTREQUEST</arg>
                <arg attribute="idReport">CRE0150</arg>
            </subarg>
            <subarg>
                <arg attribute="label">EXCEL</arg>
                <arg attribute="icon">/icons/ico_excel.png</arg>
                <arg attribute="keyStroke">F9</arg>
                <arg attribute="typePackage">XLSREPORTREQUEST</arg>
                <arg attribute="idReport">XLS0013</arg>
            </subarg>
            <arg>NEW</arg>
            <arg>EXIT</arg>
        </parameters>
        <events>
            <object>
                <name>NEW</name>
                <component>
                    <driver>this</driver>
                    <method>cleanExternalValues</method>
                </component>
                <component>
                    <driver id="fechai">common.gui.components.XMLDateField</driver>
                    <method>clean</method>
                </component>
                <component>
                    <driver id="fechaf">common.gui.components.XMLDateField</driver>
                    <method>clean</method>
                </component>
                <component>
                    <driver id="idcta">client.gui.components.EmakuSearchField</driver>
                    <method>clean</method>
                </component>
                <component>
                    <driver id="idctafinal">client.gui.components.EmakuSearchField</driver>
                    <method>clean</method>
                </component>
                <component>
                    <driver id="centro">client.gui.components.XMLComboBox</driver>
                    <method>clean</method>
                </component>
                <component>
                    <driver>this</driver>
                    <method>cleanExternalValues</method>
                </component>
            </object>
            <object>
                <name>EXCEL</name>
                <component>
                    <driver>this</driver>
                    <method>getPackage</method>
                    <parameters>
                        <arg attribute="blankPackage">true</arg>
                        <subarg>
                            <arg attribute="importValue">idcta</arg>
                            <arg attribute="importValue">idctafinal</arg>
                            <arg attribute="importValue">fechai</arg>
                            <arg attribute="importValue">fechaf</arg>
                            <arg attribute="importValue">centro</arg>                            
                        </subarg>
                    </parameters>
                </component>
            </object>
            <object>
                <name>REPORT</name>
                <component>
                    <driver>this</driver>
                    <method>getPackage</method>
                    <parameters>
                        <arg attribute="blankPackage">true</arg>
                        <subarg>
                            <arg attribute="importValue">idcta</arg>
                            <arg attribute="importValue">idctafinal</arg>
                            <arg attribute="importValue">fechai</arg>
                            <arg attribute="importValue">fechaf</arg>
                            <arg attribute="importValue">centro</arg>                            
                        </subarg>
                    </parameters>
                </component>
            </object>
        </events>
    </component>
</FORM>