<FORM>
    <preferences>
        <size width="350" height="170" />
        <name>Reporte Pintuco - JBESAS</name>
        <icon>REPORT</icon>
        <iconificable />
        <resizable />
        <closable />
    </preferences>
    <panel locate="North" type="FlowLayout" />
    <panel locate="West" type="FlowLayout" />
    <panel locate="East" type="FlowLayout" />
    <panel locate="Center" type="BorderLayout">
		<panel locate="West" type="GridLayout" rows="2" cols="1">
			<component>
				<driver id="fechai">common.gui.components.XMLLabel</driver>
				<parameters>
					<arg attribute="text">FECHAI</arg>
				</parameters>
			</component>
			<component>
				<driver id="fechaf">common.gui.components.XMLLabel</driver>
				<parameters>
					<arg attribute="text">FECHAF</arg>
				</parameters>
			</component>
		</panel>
		<panel locate="Center" type="GridLayout" rows="2" cols="1">
			<component>
				<driver id="fechai">common.gui.components.XMLDateField</driver>
				<parameters>
					<arg attribute="dateFormatString">yyyy-MM-dd HH:mm:ss</arg>
					<arg attribute="exportValue">fechai</arg>
				</parameters>
			</component>
			<component>
				<driver id="fechaf">common.gui.components.XMLDateField</driver>
				<parameters>
					<arg attribute="dateFormatString">yyyy-MM-dd HH:mm:ss</arg>
					<arg attribute="exportValue">fechaf</arg>
				</parameters>
			</component>
		</panel>
	</panel>
    <component locate="South">
        <driver id="buttons">common.gui.components.ButtonsPanel</driver>
        <parameters>
		<subarg>
				<arg attribute="label">EXCEL</arg>
				<arg attribute="icon">/icons/ico_excel.png</arg>
				<arg attribute="keyStroke">F9</arg>
				<arg attribute="typePackage">XLSREPORTREQUEST</arg>
				<arg attribute="idReport">XLS0096</arg>
			</subarg>
            <arg>NEW</arg>
            <arg>EXIT</arg>
        </parameters>
        <events>
            <object>
                <name>NEW</name>
                <component>
					<driver>this</driver>
					<method>cleanExternalValues</method>
				</component>
                <component>
                    <driver id="fechai">common.gui.components.XMLDateField</driver>
                    <method>clean</method>
                </component>
                <component>
                    <driver id="fechaf">common.gui.components.XMLDateField</driver>
                    <method>clean</method>
                </component>
            </object>
            <object>
                <name>EXCEL</name>
                <component>
					<driver>this</driver>
					<method>getPackage</method>
					<parameters>
						<arg attribute="blankPackage">true</arg>
						<subarg>
							<arg attribute="importValue">fechai</arg>
							<arg attribute="importValue">fechaf</arg>
						</subarg>
					</parameters>
				</component>
            </object>
        </events>
    </component>
</FORM>
