<FORM>
  <preferences>
    <size height="260" width="450"/>
    <name>Activar Vigencia Cotizaciones - Pedidos</name>
    <icon>/icons/ico_ext_diurno_16x16.png</icon>
    <iconificable/>
    <resizable />
    <date/>
    <closable/>

    <exportValue>delete,-1</exportValue>
    <notCleanExportValue>delete</notCleanExportValue>

  </preferences>
<component>
    <driver id="date">common.gui.components.GenericData</driver>
    <parameters>
      <subarg>
        <arg attribute="format">TEXT</arg>
        <arg attribute="size">10</arg>
        <arg attribute="maxlength">50</arg>
        <arg attribute="enabled">false</arg>
        <arg attribute="return">false</arg>
        <arg attribute="clean">false</arg>
        <arg attribute="alignment">CENTER</arg>
        <arg attribute="exportValue">fechaactual</arg>
        <arg attribute="systemDate">yyyy-MM-dd</arg>
        <arg attribute="printable">true</arg>
      </subarg>
    </parameters>
  </component>
  <component>
    <driver id="ndocumento">common.gui.components.GenericData</driver>
    <parameters>
      <arg attribute="keySQL">JBSEL0036</arg>
        <arg attribute="driverEvent" id="numero">common.gui.components.GenericData</arg>
      <subarg>
        <arg attribute="format">STRING</arg>
        <arg attribute="size">20</arg>
        <arg attribute="maxlength">20</arg>
        <arg attribute="exportValue">ndocumento</arg>
      </subarg>
    </parameters>
  </component>

  <panel locate="North" type="FlowLayout"/>
  <panel locate="East" type="FlowLayout"/>
  <panel type="BorderLayout" locate="Center">
    <!-- <panel font="Dialog,1,12" icon="CUENTAB" name="Registro de Software" type="BorderLayout"> -->
    <panel type="BorderLayout">
      <panel locate="North" type="BorderLayout">
        <panel cols="1" locate="West" rows="5" type="GridLayout">
          <component>
            <driver>common.gui.components.XMLLabel</driver>
            <parameters>
              <arg attribute="text">Documento</arg>
              <arg attribute="alignment">0</arg>
            </parameters>
          </component>
          <component>
            <driver>common.gui.components.XMLLabel</driver>
            <parameters>
              <arg attribute="text">Número</arg>
              <arg attribute="alignment">0</arg>
            </parameters>
          </component>
          <component>
            <driver>common.gui.components.XMLLabel</driver>
            <parameters>
              <arg attribute="text">Fecha Vencimiento</arg>
              <arg attribute="alignment">0</arg>
            </parameters>
          </component>
          <component>
            <driver>common.gui.components.XMLLabel</driver>
            <parameters>
              <arg attribute="text">Días Adicionales</arg>
              <arg attribute="alignment">0</arg>
            </parameters>
          </component>
          <component>
            <driver>common.gui.components.XMLLabel</driver>
            <parameters>
              <arg attribute="text">Nueva Fecha Vencimiento</arg>
              <arg attribute="alignment">0</arg>
            </parameters>
          </component>
        </panel>
        <panel cols="1" locate="Center" rows="5" type="GridLayout">
          <component locate="Center">
            <driver id="tipo_doc">client.gui.components.XMLComboBox</driver>
            <parameters>
              <arg attribute="sqlCombo">JBSEL0035</arg>
              <arg attribute="preferredLength">250</arg>
              <arg attribute="selectedIndex">0</arg>
              <arg attribute="clean">false</arg>
              <arg attribute="exportValue">codigotipo</arg>
            </parameters>
          </component>
          <component>
                <driver id="numero">common.gui.components.GenericData</driver>
                <parameters>
                  <!-- arg attribute="sqlInit">MDSEL0265</arg-->
                  <subarg>
                    <arg attribute="format">INTEGER</arg>
                    <arg attribute="size">10</arg>
                    <arg attribute="maxlength">2</arg>
                    <arg attribute="exportValue">numerodocumento</arg>
                    <arg attribute="importValue">codigotipo</arg>
                    <arg attribute="sqlCode">JBSEL0036</arg> <!--ndocumento-->
                    <arg attribute="sqlCode">JBSEL0037</arg> <!--vigenciaactual-->
                  </subarg>
                </parameters>
              </component>
              <component>
                <driver id="vigenciaactual">common.gui.components.GenericData</driver>
                <parameters>
                  <arg attribute="keySQL">JBSEL0037</arg>
                    <arg attribute="driverEvent" id="numero">common.gui.components.GenericData</arg>
                  <subarg>
                    <arg attribute="format">STRING</arg>
                    <arg attribute="size">10</arg>
                    <arg attribute="enabled">false</arg>
                    <arg attribute="maxlength">50</arg>
                  </subarg>
                </parameters>
              </component>
          <!-- <component><driver id="nombre">client.gui.components.EmakuSearchField</driver><parameters><subarg><arg attribute="size">20</arg><arg attribute="maxlength">20</arg><arg attribute="nullValue">true</arg><arg attribute="exportValue">nombre</arg><arg attribute="format">TEXT</arg><arg attribute="enabled">true</arg><arg attribute="clean">true</arg><arg attribute="sqlCode">LCSEL0277</arg><arg attribute="sqlCodeExportValue">DESEL0001,_pin,_fecha,_id_software,_ambiente,_url_ambiente,_test_sed_id,_url_busqueda,_ciiu</arg></subarg></parameters></component>-->
              <component>
                <driver id="dias">common.gui.components.GenericData</driver>
                <parameters>
                  <!-- arg attribute="sqlInit">MDSEL0265</arg-->
                  <subarg>
                    <arg attribute="format">INTEGER</arg>
                    <arg attribute="size">3</arg>
                    <arg attribute="maxlength">2</arg>
                    <arg attribute="exportValue">dias</arg>
                  </subarg>
                </parameters>
              </component>
              <component locate="West">
                  <driver id="vencimiento">common.gui.components.GenericData</driver>
                  <parameters>
                    <arg attribute="panel">true</arg>
                    <subarg>
                      <arg attribute="format">TEXT</arg>
                      <arg attribute="size">10</arg>
                      <arg attribute="maxlength">50</arg>
                      <arg attribute="enabled">false</arg>
                      <arg attribute="return">false</arg>
                      <arg attribute="clean">true</arg>
                      <arg attribute="calculateDate">fechaactual+dias</arg>
                      <arg attribute="dateFormat">yyyy-MM-dd</arg>
                      <arg attribute="printable">true</arg>
                    </subarg>
                  </parameters>
                </component>

            <!-- <component locate="Center">
              <driver id="estado">client.gui.components.XMLCheckBox</driver>
              <parameters>
                <arg attribute="sqlInit">LCSEL0295</arg>
                  <arg attribute="queryOnInit">true</arg>
                <subarg>
                  <arg attribute="sqlInit">LCSEL0295</arg>
                  <arg attribute="queryOnInit">true</arg>
                  <arg attribute="exportValue">estado</arg>
                  <arg attribute="keySQL">LCSEL0283</arg>
                  <arg attribute="driverEvent" id="nombre">client.gui.components.EmakuSearchField</arg>
                  <arg attribute="label">Activo [■] / Inactivo [ ]</arg>
                </subarg>
              </parameters>
            </component>           -->
        </panel>
      </panel>     
    </panel>
  </panel>

<panel locate="South" type="BorderLayout">
 

  <component locate="East">
    <driver>common.gui.components.ButtonsPanel</driver>
    <parameters>
      <arg>SAVE</arg>
      <arg>NEW</arg>
      <arg>EXIT</arg>
    </parameters>
    <events>
      <object>
        <name>NEW</name>

        <component>
          <driver id="delete">common.gui.components.ButtonsPanel</driver>
          <method>setEnabled</method>
          <parameters>
            <arg attribute="button">DELETE</arg>
            <arg attribute="state">true</arg>
          </parameters>
        </component>        
        <component>
          <driver id="tipo_doc">client.gui.components.XMLComboBox</driver>
          <method>clean</method>
        </component>
        <component>
          <driver id="numero">common.gui.components.GenericData</driver>
          <method>clean</method>
        </component>
        <component>
          <driver id="vencimiento">common.gui.components.GenericData</driver>
          <method>clean</method>
        </component>
        <component>
          <driver id="vigenciaactual">common.gui.components.GenericData</driver>
          <method>clean</method>
        </component>
        <component>
          <driver id="dias">common.gui.components.GenericData</driver>
          <method>clean</method>
        </component>
        <!--  limpiando llaves externas -->
        <component>
          <driver>this</driver>
          <method>cleanExternalValues</method>
        </component>
      </object>
      <object>
        <name>SAVE</name>
