<FORM>
    <preferences>
        <size width="350" height="230" />
        <name>Reporte de Cartera por Edades</name>
        <icon>REPORT</icon>
        <iconificable />
        <resizable />
        <closable />
    </preferences>
    <panel locate="North" type="FlowLayout" />
    <panel locate="West" type="FlowLayout" />
    <panel locate="East" type="FlowLayout" />
    <panel locate="Center" type="BorderLayout">
        <panel locate="West" type="GridLayout" rows="3" cols="1">
            
            <component>
                <driver>common.gui.components.XMLLabel</driver>
                <parameters>
                    <arg attribute="text">FECHAF</arg>
                </parameters>
            </component>
            <!-- <component>
                <driver>common.gui.components.XMLLabel</driver>
                <parameters>
                    <arg attribute="text">Zona</arg>
                </parameters>
            </component> -->
            <component>
                <driver>common.gui.components.XMLLabel</driver>
                <parameters>
                    <arg attribute="text">Tercero</arg>
                </parameters>
            </component>
            <component>
                <driver>common.gui.components.XMLLabel</driver>
                <parameters>
                    <arg attribute="text">Clase Cartera</arg>
                </parameters>
            </component>
        </panel>
        <panel locate="Center" type="GridLayout" rows="3" cols="1">
            <component>
                <driver id="fechaf">common.gui.components.XMLDateField</driver>
                <parameters>
                    <arg attribute="exportValue">fechaf</arg>
                </parameters>
            </component>
            <!-- <component>
                <driver id="zona">client.gui.components.XMLComboBox</driver>
                <parameters>
                    <arg attribute="sqlCombo">DGSEL0270</arg>
                    <arg attribute="selectedIndex">0</arg>
                    <arg attribute="exportValue">zona</arg>
                    <arg attribute="clean">false</arg>
                    <arg attribute="addAttribute">key</arg>
                    <arg attribute="panel">false</arg>
                </parameters>
            </component> -->
            <component locate="Center">
                <driver id="idt">client.gui.components.EmakuSearchField</driver>
                <parameters>
                    <arg attribute="size">18</arg>
                    <arg attribute="maxlength">25</arg>
                    <arg attribute="nullValue">true</arg>
                    <arg attribute="exportValue">keyword</arg>
                    <arg attribute="format">TEXT</arg>
                    <arg attribute="sqlCombo">DLSEL0110</arg>
                    <arg attribute="blankArgs">false</arg>
                    <arg attribute="keyDataSearch">searchProd</arg>
                    <arg attribute="repeatData">2</arg>
                    <arg attribute="noDataBeep">true</arg>
                    <arg attribute="noDataMessage">No se encontro registros</arg>
                    <arg attribute="selectedIndex">1</arg>
                    <arg attribute="enabled">true</arg>
                    <arg attribute="clean">true</arg>
                </parameters>
            </component>
          <component>
            <driver id="cierre">client.gui.components.XMLComboBox</driver>
            <parameters>
              <arg attribute="selectedIndex">1</arg>
              <arg attribute="sqlCombo">HCSEL0034</arg>
              <arg attribute="Panel">true</arg>
              <arg attribute="exportValue">clase</arg>
            </parameters>
          </component>
        </panel>
    </panel>
   <component locate="South">
        <driver>common.gui.components.ButtonsPanel</driver>
        <parameters>
            <subarg>
                <arg attribute="label">REPORT</arg>
                <arg attribute="icon">REPORT</arg>
                <arg attribute="keyStroke">F9</arg>
                <arg attribute="typePackage">REPORTREQUEST</arg>
                <arg attribute="idReport">CRE0158</arg>
            </subarg>
        
            <arg>NEW</arg>
            <arg>EXIT</arg>
        </parameters>
        <events>
            <object>
                <name>NEW</name>
                <component>
            <driver id="idt">client.gui.components.EmakuSearchField</driver>
                    <method>clean</method>
                </component>
                <!--  limpiando llaves externas -->
                <component>
                    <driver>this</driver>
                    <method>cleanExternalValues</method>
                </component>
            </object>
            <object>
                <name>REPORT</name>
                <component>
                    <driver>this</driver>
                    <method>getPackage</method>
                    <parameters>
                        <arg attribute="blankPackage">true</arg>
                        <subarg>
                            <arg attribute="importValue">clase</arg>                            
                            <arg attribute="importValue">fechaf</arg>
                            <!-- <arg attribute="importValue">zona</arg> -->
                            <arg attribute="importValue">keyword</arg>
                            <arg attribute="importValue">keyword</arg>
                        </subarg>
                    </parameters>
                </component>
            </object>
        </events>
    </component>
</FORM>
