<emaku_template type="GRAPHIC" requestNumeration="true" silence="false" printer="DeskJet-3920-1">
	<settings width="612" height="792" />
	<metadata>
		<font row="0" col="0" name="Sans" size="16" />
		<field row="80" col="250" type="STRING">TRASLADO DE MERCANCIA</field>
		<font row="0" col="0" name="Sans" size="10" />
		<!-- Encabezado MT -->
		<image row="10" col="25" width="100" height="75">/icons/logo_fac.png</image>
		<barcodeImage row="145" col="390" />
		<roundedRectangle row="220" col="20" width="565" height="520" />
		<roundedRectangle row="220" col="20" width="565" height="15" />
		<roundedRectangle row="700" col="20" width="565" height="40" />
		<field row="120" col="390" type="STRING">Fecha:</field>
		<!--  <font row="0" col="0" name="Sans" size="14"/>-->
		<ndocument row="130" col="480" />
		<field row="150" col="45" type="STRING">Usuario</field>
		<field row="162" col="45" type="STRING">Bodega Salida</field>
		<field row="174" col="45" type="STRING">Bodega Entrante</field>

		<field row="130" col="390" type="STRING">Numero:</field>
		<field row="130" col="455" type="STRING">AC-</field>
		<field row="710" col="30" type="STRING">Observaciones:</field>
		<font row="0" col="0" name="Sans" size="8" />
		<!-- Detalles -->
		<line row="220" col="97" row2="700" col2="97" />
		<line row="220" col="175" row2="700" col2="175" />
		<line row="220" col="400" row2="700" col2="400" />
		<line row="220" col="480" row2="700" col2="480" />
		<line row="220" col="517" row2="700" col2="517" />

		<field row="230" col="35" type="STRING">Codigo</field>
		<field row="230" col="100" type="STRING">Referencia</field>
		<field row="230" col="240" type="STRING">Descripcion</field>
		<field row="230" col="405" type="STRING">Color</field>
		<field row="230" col="483" type="STRING">Talla</field>
		<field row="230" col="527" type="STRING">Cantidad</field>
		<!-- Pie de pagina -->
		<field row="753" col="20" type="STRING">YENNY ROCIO SANCHEZ R. - Nit. 27314494 - CC VALLE DE ATRIZ - Tel. 7330063</field>
	</metadata>
	<newpage>
		<font row="0" col="0" name="Sans" size="16" />
		<field row="80" col="240" type="STRING">TRASLADO MERCANCIA</field>
		<image row="30" col="25" width="100" height="75">/icons/logo_fac.png</image>
		<generateBarCodeImage row="135" col="380" />
		<field row="80" col="450" type="STRING">PAGINA:</field>
		<pagenumber row="80" col="530" />
		<font row="0" col="0" name="Sans" size="7" />
		<roundedRectangle row="140" col="20" width="565" height="620" />

		<line row="156" col="20" row2="156" col2="585" />
		<line row="140" col="97" row2="760" col2="97" />
		<line row="140" col="175" row2="760" col2="175" />
		<line row="140" col="400" row2="760" col2="400" />
		<line row="140" col="480" row2="760" col2="480" />
		<line row="140" col="517" row2="760" col2="517" />

		<field row="150" col="35" type="STRING">Codigo</field>
		<field row="150" col="100" type="STRING">Referencia</field>
		<field row="150" col="240" type="STRING">Descripcion</field>
		<field row="150" col="405" type="STRING">Color</field>
		<field row="150" col="483" type="STRING">Talla</field>
		<field row="150" col="527" type="STRING">Cantidad</field>
	</newpage>
	<package>
		<field row="120" col="455" fontName="Sans" fontSize="10" type="DATE" mask="yyyy-MM-dd" />
	</package>
	<package>
		<field row="720" col="25"  type="TEXT" width="60" height="3" rowAcum="10" />
	</package>
	<package>
		<field row="162" col="145" fontName="Sans" fontSize="9" type="STRING" />
	</package>
	<package>
		<field row="174" col="145" fontName="Sans" fontSize="9" type="STRING" />
	</package>
	<package>
		<field row="150" col="150" fontName="Sans" fontSize="10" type="STRING" />
	</package>
	<package>
		<subpackage rowInit="250" rowAcum="12" maxRowsAcum="37" rowInitNewPage="170" maxRowsAcumNewPage="50">
			<field col="25" type="STRING" />
			<field col="100" type="STRING" />
			<field col="410" type="STRING" />
			<field col="485" type="STRING" />
			<field col="180" type="STRING" />
			<field col="570" type="NUMERIC" mask="##,###" />
		</subpackage>
	</package>
</emaku_template>

