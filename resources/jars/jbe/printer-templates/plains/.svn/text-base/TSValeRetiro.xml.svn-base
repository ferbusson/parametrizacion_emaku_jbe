<emaku_template type="PLAIN" silent="false" printer="lp">
	<metadata>
		<scp row="last" col="1" >NL</scp>
		<field row="last" col="11" type="STRING">BERCELI MEDINA</field>
		<field row="last" col="16" type="STRING">ALMACENES</field>
		<field row="last" col="10" type="STRING">MT</field>
		<field row="last" col="14" type="STRING">CR 6 N° 13 - 87</field>
		<field row="last" col="16" type="STRING">IPIALES</field>
		<field row="last" col="12" type="STRING">Nit. </field>
		<scp row="last" col="1" >NL</scp>
		<field row="last" col="13" type="STRING">VALE DE RETIRO</field>
		<scp row="last" col="1" >NL</scp>
		<field row="last" col="1" type="STRING">Numero:</field>
		<field row="last" col="1" type="STRING">IPIALES,</field>
		<field row="last" col="1" type="STRING">Cajero:</field>
		<scp row="last" col="1" >NL</scp>
		<field row="last" col="13" type="STRING">BENEFICIARIO</field>
		<line row="last"   col="1" length="40" charfill="-" align="horizontal" />
	</metadata>
	<package>
		<field row="10" col="9" width="10" type="NUMERIC" mask="0000000000"/>
	</package>
	<package>
			<field row="11" col="11" type="DATE" mask="EEEEEE dd MMMM yyyy"/>
	</package>
	<package>
		<field row="12" col="9" type="STRING"/>
	</package>
	<package>
		<field row="last" col="7" incrementRow="true" type="STRING"/>
		<field row="last" col="7" incrementRow="true" type="STRING"/>
		<field row="last" col="7" incrementRow="true" type="STRING"/>
		<field row="last" col="7" incrementRow="true" type="STRING"/>
		<field row="last" col="7" incrementRow="true" type="STRING"/>
	</package>
	<line row="last"   col="1" length="40" charfill="-" align="horizontal" />
	<package>
		<field row="last" separatorchar="LA SUMA DE" separatorcol="1" incrementRow="true" col="15" width="16" type="NUMERIC" mask="[##,###,###]" />
	</package>
	<package>
		<field row="last"  incrementRow="true" col="1" width="40" height="3" type="NUMTOLETTERS"/>
	</package>
	<line row="last"   col="1" length="40" charfill="-" align="horizontal" />
	<field row="last" col="13">POR CONCEPTO</field>
	<package validate="true">
		<field row="last" col="1"  width="40"  height="4" type="TEXT"/>
	</package>
	<scp row="last" col="1" >NL</scp>
	<scp row="last" col="1" >NL</scp>
	<line row="last"   col="10" length="20" charfill="_" align="horizontal" />
	<field row="last" col="15">ACEPTADA</field>
	<scp row="last" col="1" >NL</scp>
	<scp row="last" col="1" >NL</scp>
	<scp row="last" col="1" >NL</scp>
	<scp row="last" col="1" >NL</scp>
	<scp row="last" col="1" >NL</scp>
	<scp row="last" col="1" >NL</scp>
	<scp row="last" col="1" >NL</scp>
</emaku_template>
