<emaku_template type="PLAIN" requestNumeration="true" name="Nueva Devolucion En Ventas" printer="epsonoffice">
	<metadata>
		<scp row="last" col="1">NL</scp>
		<field row="last" col="11" type="STRING">BERCELI MEDINA</field>
		<field row="last" col="16" type="STRING">ALMACENES</field>
		<field row="last" col="10" type="STRING">MT</field>
		<field row="last" col="12" type="STRING">NIT</field>
		<field row="last" col="14" type="STRING">REGIMEN COMUN</field>
		<field row="last" col="13" type="STRING">CRA 6 N° 13 - 87</field>
		<field row="last" col="16" type="STRING">IPIALES</field>
		<scp row="last" col="1">NL</scp>
		<scp row="last" col="1">NL</scp>
		<!-- Datod personales -->
		<!-- Informacion documento -->
		<field row="last" col="1" type="STRING">AJUSTE DE INVENTARIO</field>
		<field row="last" col="1" type="STRING">Numero:</field>
		<field row="last" col="1" type="STRING">Ipiales,</field>
		<field row="last" col="1" type="STRING">Bodega:</field>
		<ndocument row="12" col="10" />
		<!-- Informacion detallada de productos -->
		<line row="last" col="1" length="40" charfill="-" align="horizontal" />
		<field row="last" col="1" type="STRING">Descripcion</field>
		<field row="last" incrementRow="false" col="1" type="STRING">Sistema</field>
		<field row="last" incrementRow="false" col="12" type="STRING">Fisico</field>
		<field row="last" incrementRow="false" col="23" type="STRING">Ajuste</field>
		<line row="last" col="1" length="40" charfill="-" align="horizontal" />
	</metadata>
	<!-- Paquetes -->
	<!-- Datos Personales -->
	<package>
		<field row="13" col="10" type="DATE" mask="EEEEEE dd MMMM yyyy" />
	</package>
	<!--  <package>
		<field row="14" col="10" type="STRING" />
		</package>-->
	<!-- Detalles -->
	<package validate="true">
		<subpackage rowInit="last">
			<field col="1" width="5" incrementRow="false" type="NUMERIC" mask="####" />
			<field col="6" incrementRow="false" type="STRING" />
			<field col="10" incrementRow="false" type="STRING" />
			<field col="40" incrementRow="false" type="STRING" />
			<field col="50" incrementRow="false" type="STRING" />
			<field col="70" width="5" incrementRow="false" type="NUMERIC" mask="####" />
			<field col="80" width="5" incrementRow="false" type="NUMERIC" mask="####" />
		</subpackage>
	</package>
	<!-- SubTotales -->
	<!-- SubTotales -->
	<!-- <line row="last"   col="1" length="40" charfill="-" align="horizontal" />
		<line row="last"   col="1" length="40" charfill="-" align="horizontal" />
