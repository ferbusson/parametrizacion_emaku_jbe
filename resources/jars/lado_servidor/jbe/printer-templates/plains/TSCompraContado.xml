<emaku_template type="PLAIN" requestNumeration="false" silent="false" printer="lp">
	<metadata>
		<scp row="last" col="1">NL</scp>
		<field row="last" col="11" type="STRING">BERCELI MEDINA</field>
		<field row="last" col="16" type="STRING">ALMACENES</field>
		<field row="last" col="16	" type="STRING">MT</field>
		<field row="last" col="12" type="STRING">NIT </field>
		<field row="last" col="14" type="STRING">REGIMEN COMUN</field>
		<field row="last" col="13" type="STRING">CRA 6 N° 13 - 87</field>
		<field row="last" col="16" type="STRING">IPIALES</field>
		<field row="last" col="16" type="STRING" />
		<!-- Datod personales -->
		<!-- Informacion documento -->
		<field row="last" col="11" type="STRING">COMPRA DE CONTADO</field>
		<field row="last" col="16" type="STRING" />
		<field row="last" col="1" type="STRING">Numero:</field>
		<field row="last" col="1" type="STRING">Ipiales,</field>
		<field row="last" col="1" type="STRING">F. Proveedor:</field>
		<field row="last" col="16" type="STRING" />

	</metadata>
	<package>
		<field row="12" col="15" width="10" type="NUMERIC" mask="0000000000" />
	</package>

	<package>
		<field row="13" col="10" type="DATE" mask="EEEEEE dd MMMM yyyy" />
	</package>
	<package>
		<field row="14" col="15" width="10" type="NUMERIC" mask="0000000000" />
	</package>
	<package>
		<field row="last" incrementRow="true" col="1" type="STRING" />
		<field row="last" incrementRow="true" col="1" type="STRING" />
		<field row="last" incrementRow="true" col="1" type="STRING" />
		<field row="last" incrementRow="true" col="1" type="STRING" />
		<field row="last" incrementRow="true" col="1" type="STRING" />
	</package>
	<field row="last" col="16" type="STRING" />

	<!-- Informacion detallada de productos -->
	<line row="last" col="1" length="40" charfill="-" align="horizontal" />
	<field row="last" col="1" type="STRING">Descripcion</field>
	<field row="last" incrementRow="false" col="1" type="STRING">Cant</field>
	<field row="last" incrementRow="false" col="12" type="STRING">V. Unit</field>
	<field row="last" incrementRow="false" col="23" type="STRING">IVA</field>
	<field row="last" col="30" type="STRING">Total</field>
	<line row="last" col="1" length="40" charfill="-" align="horizontal" />
	<package validate="true">
		<subpackage rowInit="last">
			<field col="1" incrementRow="false" type="STRING" />
			<field col="41" width="3" incrementRow="false" type="NUMERIC" mask="###" />
			<field col="48" width="10" incrementRow="false" type="NUMERIC" mask="#,###,###" />
			<field col="64" width="2" incrementRow="false" type="NUMERIC" mask="##" />
			<field col="66" width="13" type="NUMERIC" mask="#,###,###" />
		</subpackage>
	</package>
	<!-- SubTotales -->
	<line row="last" col="1" length="40" charfill="-" align="horizontal" />
	<package>
		<field row="last" separatorchar="NETO" separatorcol="1" incrementRow="true" col="19" width="16" type="NUMERIC" mask="#,###,###" />
		<field row="last" separatorchar="DESCUENTO" separatorcol="1" incrementRow="true" col="14" width="16" type="NUMERIC" mask="#,###,###" />
		<field row="last" separatorchar="IVA" separatorcol="1" incrementRow="true" col="20" width="16" type="NUMERIC" mask="#,###,###" />
		<field row="last" separatorchar="TOTAL" separatorcol="1" incrementRow="true" col="18" width="16" type="NUMERIC" mask="#,###,###" />
		<field row="last" separatorchar="GASTOS" separatorcol="1" incrementRow="true" col="17" width="16" type="NUMERIC" mask="#,###,###" />
		<field row="last" separatorchar="TOTAL COMPRA" separatorcol="1" incrementRow="true" col="11" width="16" type="NUMERIC" mask="#,###,###" />
	</package>
	<line row="last" col="1" length="40" charfill="-" align="horizontal" />
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
</emaku_template>
