<emaku_template type="PLAIN" printer="epsonoffice">
		<settings width="80" height="30" />
		<metadata>
				<scp row="1" col="1">ESC</scp>
				<scp row="1" col="2">C</scp>
				<scp row="1" col="3">33</scp>
				<scp row="1" col="5">ETB</scp>
				<scp row="1" col="6">DC2</scp>
				<scp row="1" col="7">ETB</scp>
				<scp row="33" col="1">FF</scp>
				<scp row="33" col="2">EOT</scp>
				<!-- Encabezado -->
				<line row="1" col="1" length="84" charfill="=" align="horizontal" />
				<field row="2" col="2" type="STRING">F.A. Uribe &amp; Cia Ltda</field>
				<field row="3" col="3" type="STRING">Nit.  891.200.250-1</field>
				<field row="2" col="56" type="STRING">NOTA DE PRODUCCION</field>
				<field row="3" col="56" type="STRING">Nro.</field>
				<line row="4" col="1" length="84" charfill="=" align="horizontal" />
				<field row="5" col="2" type="STRING">Pasto,</field>
				<line row="6" col="1" length="84" charfill="=" align="horizontal" />
				<!-- Informacion detallada de productos -->
				<field row="7" col="3" type="STRING">Referencia</field>
				<field row="7" col="35" type="STRING">Descripcion</field>
				<field row="7" col="72" type="STRING">Cantidad</field>
				<field row="25" col="3" type="STRING">Observaciones</field>
				
				<line row="30" col="13" length="15" charfill="_" align="horizontal" />
				<field row="31" col="13" type="STRING">Elaboro</field>
				
				<line row="30" col="35" length="15" charfill="_" align="horizontal" />
				<field row="31" col="35" type="STRING">Reviso</field>

				<line row="30" col="57" length="15" charfill="_" align="horizontal" />
				<field row="31" col="57" type="STRING">Contabilizo</field>
				<!-- Dibujo de lineas -->
				<line row="8" col="1" length="84" charfill="=" align="horizontal" />
				<line row="24" col="1" length="84" charfill="=" align="horizontal" />
				
				<field row="7" col="15" type="STRING">|</field>
				<field row="7" col="68" type="STRING">|</field>

				<line row="9" col="15" length="15" charfill="|" align="vertical" />
				<line row="9" col="68" length="15" charfill="|" align="vertical" />
		</metadata>
		<package>
				<field row="3" col="61" type="STRING"/>
		</package>
		<package>
				<field row="5" col="9" type="DATE" mask="EEEEEE dd MMMM yyyy"/>
		</package>
		<package>
				<subpackage rowInit="9">
						<field col="2" type="STRING" />
						<field col="17" type="STRING" />
						<field col="79" width="4" type="NUMERIC" mask="###,###" />
				</subpackage>
		</package>
		<package>
				<field row="26" col="2" type="TEXT" width="84" height="3" />
		</package>
</emaku_template>