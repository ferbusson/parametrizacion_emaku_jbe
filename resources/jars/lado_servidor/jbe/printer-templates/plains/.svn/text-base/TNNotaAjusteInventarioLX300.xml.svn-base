<emaku_template type="PLAIN" requestNumeration="true"  silent="true" printer="epsonoffice">
		<settings width="137" height="33" />
		<metadata>
				<scp row="last" incrementRow="false" col="1">ESC</scp>
				<scp row="last" incrementRow="false" col="2">C</scp>
				<scp row="last" incrementRow="false" col="3">33</scp>
				<scp row="last" incrementRow="false" col="5">ETB</scp>
				<scp row="last" incrementRow="false" col="6">SI</scp>
				<scp row="last" incrementRow="false" col="7">ETB</scp>
				<line row="last" col="8" length="135" charfill="=" align="horizontal" />
				<field row="last" col="1" type="STRING" incrementRow="false">BERCELI MEDINA</field>
			  <field row="last" col="2" type="STRING" incrementRow="false">ALMACENES MT</field>
			  <field row="last" col="2" type="STRING" incrementRow="false">CRA 6 N° 13 - 87</field>  
			  <field row="last" col="2" type="STRING" incrementRow="false">IPIALES</field>  
				<field row="last" col="100" type="STRING">NOTA DE AJUSTE DE INVENTARIOS</field>
				<field row="last" col="1" type="STRING" incrementRow="false">Nit. </field>
				<field row="last" col="100" type="STRING" incrementRow="false">Nro.</field>
				<ndocument row="last" col="105"/>
				<line row="last" col="1" length="137" charfill="=" align="horizontal" />
				<field row="last" col="2" type="STRING">Ipiales,</field>
				<field row="last" col="2" type="STRING">Bodega: </field>
				<line row="last" col="1" length="137" charfill="=" align="horizontal"/>
				<field row="last" col="3" incrementRow="false" type="STRING">Referencia</field>
				<field row="last" col="15" incrementRow="false" type="STRING">|</field>
				<field row="last" col="35" incrementRow="false" type="STRING">Descripcion</field>
				<field row="last" col="67" incrementRow="false" type="STRING">|</field>
				<field row="last" col="68" incrementRow="false" type="STRING">Saldo Sistema</field>
				<field row="last" col="81" incrementRow="false" type="STRING">|</field>
				<field row="last" col="83" incrementRow="false" type="STRING">Saldo Fisico</field>
				<field row="last" col="99" incrementRow="false" type="STRING">|</field>
				<field row="last" col="102" incrementRow="false" type="STRING">Ajuste</field>
				<field row="last" col="115" incrementRow="false" type="STRING">|</field>
				<field row="last" col="125"  type="STRING">Valor</field>
				<!-- Dibujo de lineas -->
				<line row="last" col="1" length="137" charfill="=" align="horizontal"/>
				<header repeatEach="32">
					<!-- Informacion detallada de productos -->
					<scp row="last" incrementRow="false" col="1">ESC</scp>
					<scp row="last" incrementRow="false" col="2">C</scp>
					<scp row="last" incrementRow="false" col="3">33</scp>
					<scp row="last" incrementRow="false" col="5">ETB</scp>
					<line row="last" col="8" length="135" charfill="=" align="horizontal" />
					<field row="last" col="2" type="STRING" incrementRow="false">ALMACENES MT</field>
					<field row="last" col="100" type="STRING">NOTA DE AJUSTE DE INVENTARIOS</field>
					<field row="last" col="3" type="STRING" incrementRow="false">Nit.  </field>
					<field row="last" col="93" type="STRING" incrementRow="false">Nro.</field>
					<ndocument row="last" incrementRow="false" col="97"/>
					<field row="last" col="61"  incrementRow="false" type="STRING">PAGINA</field>
					<pageNumeration row="last" col="69" type="STRING"/>
					<line row="last" col="1" length="137" charfill="=" align="horizontal"/>
					<field row="last" col="3" incrementRow="false" type="STRING">Referencia</field>
					<field row="last" col="15" incrementRow="false" type="STRING">|</field>
					<field row="last" col="35" incrementRow="false" type="STRING">Descripcion</field>
					<field row="last" col="76" incrementRow="false" type="STRING">|</field>
					<field row="last" col="80" incrementRow="false" type="STRING">Saldo Sistema</field>
					<field row="last" col="99" incrementRow="false" type="STRING">|</field>
					<field row="last" col="102" incrementRow="false" type="STRING">Saldo Real</field>
					<field row="last" col="115" incrementRow="false" type="STRING">|</field>
					<field row="last" col="125"  type="STRING">Ajuste</field>
					<!-- Dibujo de lineas -->
					<line row="last" col="1" length="137" charfill="=" align="horizontal"/>
				</header>
		</metadata>
		<package>
				<field row="8" col="9" type="DATE" mask="EEEEEE dd MMMM yyyy"/>
		</package>
		<package>
				<field row="9" col="11" type="STRING"/>
		</package>
		<package>
				<subpackage rowInit="last">
						<field col="2" type="STRING" separatorchar="|" separatorcol="15"/>
						<field col="17" type="STRING" separatorchar="|" separatorcol="76"/>
						<field col="66" width="7" type="NUMERIC" mask="###,###" separatorchar="|" separatorcol="76"/>
						<field col="89" width="7" type="NUMERIC" mask="###,###" separatorchar="|" separatorcol="99"/>
						<field col="107" width="7" type="NUMERIC" mask="###,###" separatorchar="|" separatorcol="115"/>
						<field col="117" width="12" type="NUMERIC" mask="#,###,###.##" />
				</subpackage>
		</package>
		<line row="last" col="1" length="137" charfill="=" align="horizontal"/>
		<field row="last" col="1" type="STRING">Observaciones</field>
		<package>
				<field row="last" col="1" type="TEXT" width="84" height="3" />
		</package>
		<scp row="last" col="1">NL</scp>
		<scp row="last" col="1">NL</scp>
		<scp row="last" col="1">NL</scp>
		<field row="last" col="35" type="STRING" incrementRow="false">Elaboro</field>
		<field row="last" col="65" type="STRING" incrementRow="false">Reviso</field>
		<field row="last" col="91" type="STRING">Contabilizo</field>
		<scp row="last" incrementRow="false" col="1">FF</scp>
		<scp row="last" incrementRow="false" col="2">DC2</scp>
		<scp row="last" incrementRow="false" col="3">EOT</scp>
</emaku_template>