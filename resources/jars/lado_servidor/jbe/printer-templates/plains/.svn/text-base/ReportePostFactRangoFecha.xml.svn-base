<emaku_template type="PLAIN" silent="true" printer="epsonoffice">
	<metadata>
		<!-- Encabezado -->
		<abstract row="2" col="1" height="6">
			<![CDATA[
             ALMACENES MT
          NIT. 
   CR 6 N° 13 - 87 IPIALES (NAR) 
          Telefono: 7733324]]>
		</abstract>
		<!-- Datod personales -->
		<!-- Informacion documento -->
		<field row="8" col="7" type="STRING">REPORTE FACTURAS RANGO FECHA
</field>
		<field row="10" col="1" type="STRING">Desde:</field>
		<field row="11" col="1" type="STRING">Hasta:</field>
		<!-- Informacion detallada de productos -->
		<line row="12" col="1" length="40" charfill="-" align="horizontal" />
		<field row="13" col="1" type="STRING">FECHA</field>
		<field row="13" col="13" type="STRING">NUMERO</field>
		<field row="14" col="5" type="STRING">MESERO</field>
		<field row="14" col="35" type="STRING">VALOR</field>
		<line row="15" col="1" length="40" charfill="-" align="horizontal" />
	</metadata>
	<package>
			<field row="10" col="8" type="DATE" mask="EEEEEE dd MMMM yyyy"/>
	</package>
		<package>
			<field row="11" col="8" type="DATE" mask="EEEEEE dd MMMM yyyy"/>
	</package>
	
	<package validate="true">
		<subpackage rowInit="16">
			<field col="1" type="DATE" mask="yyyy MM dd"/>
			<field col="13" type="STRING" />
			<field col="45" type="STRING" />
			<field col="69" width="11" type="NUMERIC" mask="#,###,###" />
		</subpackage>
	</package>
	<!-- SubTotales -->
	<package>
		<field row="last" col="1" width="16" type="STRING"/>
	</package>
	<package>
		<field row="current" col="20" width="15" type="NUMERIC" mask="#,###,###" />
	</package>
	<package>
		<field row="last" col="1" width="16" type="STRING"/>
	</package>
	<package>
		<field row="last" col="1" width="16" type="STRING"/>
	</package>
</emaku_template>
