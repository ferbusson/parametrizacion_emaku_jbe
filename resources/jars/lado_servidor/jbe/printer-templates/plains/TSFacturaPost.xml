<emaku_template type="PLAIN" requestNumeration="false" silent="true" printer="TMU">
	<metadata>
		<scp row="1" col="1">NL</scp>

		<field row="last" center="40" type="STRING"></field>
                <field row="last" center="40" type="NAMEDB">establecimiento</field>
                <field row="last" center="40" type="NAMEDB">tercero</field>
                <field row="last" center="40" type="NAMEDB">nit</field>
                <field row="last" center="40" type="NAMEDB">direccion</field>
                <field row="last" center="40" type="NAMEDB">telefono</field>
                <field row="last" center="40" type="NAMEDB">ciudad</field>


		<scp row="last" col="1">NL</scp>
		<!-- Datod personales -->
		<!-- Informacion documento -->
		<field row="last" col="1" type="STRING">Factura de Venta</field>
		<field row="last" col="1" type="STRING">Numero:</field>
		<field row="last" col="1" type="STRING">Fecha:</field>
		<field row="last" col="1" type="STRING">Vendedor:</field>
		<field row="last" col="1" type="STRING">Hora:</field>
		<!-- Informacion detallada de productos -->
		<line row="last" col="1" length="42" charfill="-" align="horizontal" />
		<field row="last" col="1" type="STRING">Codigo</field>
		<field row="last" col="1" type="STRING">Descripcion</field>
		<field row="last" incrementRow="false" col="1" type="STRING">Cant</field>
		<field row="last" incrementRow="false" col="12" type="STRING">V. Unit</field>
		<field row="last" col="30" type="STRING">Total</field>
		<line row="last" col="1" length="42" charfill="-" align="horizontal" />
	</metadata>
	<package>
		<field row="10" col="11" width="16" type="STRING" />
	</package>
	<package>
		<field row="11" col="8" type="DATE" mask="EEEEEE dd MMMM yyyy" />
	</package>
	<package>
		<field row="12" col="11" width="16" type="STRING" />
	</package>
	<package>
		<field row="13" col="10" width="10" type="STRING" />
	</package>
	<package validate="true">
		<subpackage rowInit="last">
			<field col="1" type="STRING" incrementRow="false" />
			<field col="45" incrementRow="false" type="STRING" />
			<field col="86" width="3" incrementRow="false" type="NUMERIC" mask="###" />
			<field col="94" width="13" incrementRow="false" type="NUMERIC" mask="#,###,###.##" />
			<field col="113" width="13" type="NUMERIC" mask="#,###,###.##" />
		</subpackage>
	</package>
	<!-- SubTotales -->
	<line row="last" col="1" length="42" charfill="-" align="horizontal" />
	<package>
		<field row="0" col="0" width="16" type="STRING" />
	</package>
	<package>
		<field row="last" separatorchar="TOTAL" separatorcol="1" incrementRow="true" col="21" width="16" type="NUMERIC" mask="#,###,###" />
	</package>
	<package>
		<field row="last" separatorchar="EFECTIVO" separatorcol="1" incrementRow="true" col="18" width="16" type="NUMERIC" mask="#,###,###" />
	</package>
	<package>
		<field row="last" separatorchar="TARJETAS" separatorcol="1" incrementRow="true" col="20" width="16" type="NUMERIC" mask="#,###,###" />
	</package>
	<package>
		<field row="last" separatorchar="CREDITO" separatorcol="1" incrementRow="true" col="19" width="16" type="NUMERIC" mask="#,###,###" />
	</package>
	<package>
		<field row="last" separatorchar="CAMBIO" separatorcol="1" incrementRow="true" col="20" width="16" type="NUMERIC" mask="#,###,###" />
	</package>
	<package>
		<field row="0" col="0" width="16" type="STRING" />
	</package>
	<package>
		<field row="0" col="0" width="16" type="STRING" />
	</package>
	<line row="last" col="1" length="42" charfill="-" align="horizontal" />
	<package validate="true">
		<field row="last" separatorchar="BASE Impuesto IVA 16%" separatorcol="1" incrementRow="true" col="5" width="16" type="NUMERIC" mask="#,###,###" />
	</package>
	<package validate="true">
		<field row="last" separatorchar="Total IVA" separatorcol="1" incrementRow="true" col="17" width="16" type="NUMERIC" mask="#,###,###" />
	</package>
	<line row="last" col="1" length="42" charfill="-" align="horizontal" />
	<package>
		<field row="0" col="0" width="16" type="STRING" />
	</package>
	<package validate="true">
		<field row="last" separatorchar="Total articulos " separatorcol="1" incrementRow="true" col="23" type="STRING" />
	</package>
	<package>
		<field row="0" col="0" width="16" type="STRING" />
	</package>
	<scp row="last" col="1">NL</scp>
	<package validate="true">
		<field row="last" incrementRow="true" col="1" type="STRING" />
		<field row="last" incrementRow="true" col="1" type="STRING" />
		<field row="last" incrementRow="true" col="1" type="STRING" />
		<field row="last" incrementRow="true" col="1" type="STRING" />
		<field row="last" incrementRow="true" col="1" type="STRING" />
	</package>
	<package validate="true">
		<field row="last" separatorchar="DIAS DE CREDITO" separatorcol="1" incrementRow="true" col="6" width="16" type="STRING" />
	</package>
	<package validate="true">
		<field row="last" separatorchar="VENCIMIENTO" separatorcol="1" incrementRow="true" col="10" width="16" type="STRING" />
	</package>
	<package>
		<field row="0" col="0" width="16" type="STRING" />
	</package>


<!--resolucion-->


        <scp row="last" col="1">NL</scp>
        <package validate="true">
                <field row="last" separatorcol="1" incrementRow="true" col="1" width="16" type="STRING" />
        </package>
        <package validate="true">
                <field row="last" separatorcol="1" incrementRow="true" col="1" width="16" type="STRING" />
        </package>
        <package validate="true">
                <field row="last" separatorcol="1" incrementRow="true" col="1" width="16" type="STRING" />
        </package>


        <!--fin resolucion-->
	<field row="last" col="1" type="STRING">PLAZO MAX. PARA CAMBIO DE MERCANCIA</field>
        <field row="last" col="1" type="STRING">8 DIAS, POR RECLAMO FRENTE A CALIDAD,</field>
        <field row="last" col="1" type="STRING">30 DIAS, EL PLAZO MAX. PARA RETIRO DE</field>
        <field row="last" col="1" type="STRING">MERCANCIA SEPARADA 45 DIAS, NO SE HACEN </field>
        <field row="last" col="1" type="STRING">CAMBIOS DE MERCANCIA EN PROMOCION</field>
        <field row="last" col="8" type="STRING">PRESENTAR ESTA FACTURA PARA GARANTIA</field>

	<field row="last" col="15" type="STRING">Reimpresion</field>
	<field row="last" col="5" type="STRING">**** GRACIAS POR SU COMPRA ****</field>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" col="1">NL</scp>
	<scp row="last" incrementRow="false" col="1">27</scp>
	<scp row="last" incrementRow="false" col="2">105</scp>
	<package>
		<field row="0" col="0" width="16" type="STRING" />
	</package>

</emaku_template>
