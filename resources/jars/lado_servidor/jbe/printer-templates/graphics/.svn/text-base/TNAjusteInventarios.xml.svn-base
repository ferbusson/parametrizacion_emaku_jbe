	</package>
	<package>
		<field row="200" col="250" type="TEXT" width="60" height="3" rowAcum="10" />
	</package>
	<!--
	<package>
		<field row="200" col="250" type="NUMERIC" mask="#,###,###" />
	</package>
	 
	<package>
		<field row="674" col="360" type="NUMERIC" mask="###,###" />
