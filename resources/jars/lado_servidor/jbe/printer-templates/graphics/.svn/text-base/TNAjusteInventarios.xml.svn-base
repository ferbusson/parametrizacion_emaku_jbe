		<field row="710" col="30" type="STRING">Observaciones:</field>
		<font row="0" col="0" name="Sans" size="8" />
		<!-- Detalles -->
		<line row="220" col="97" row2="700" col2="97" />
		<line row="220" col="145" row2="700" col2="145" />
		<line row="220" col="260" row2="700" col2="260" />
		<line row="220" col="335" row2="700" col2="335" />
		<line row="220" col="380" row2="700" col2="380" />
		<line row="220" col="440" row2="700" col2="440" />
		<line row="220" col="517" row2="700" col2="517" />
		
