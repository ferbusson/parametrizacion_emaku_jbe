		<field row="150" col="465" type="STRING">S. Fisico</field>
		<field row="150" col="530" type="STRING">Diferencia</field>
	</newpage>	
	<package>
		<field row="120" col="450" type="DATE" mask="yyyy-MM-dd" />
	</package>
	<package>
			<field row="130" col="250" type="NUMERIC" mask="#,###,###" />
			<field row="142" col="250" type="NUMERIC" mask="#,###,###" />
			<field row="154" col="250" type="NUMERIC" mask="#,###,###" />
			<field row="166" col="250" type="NUMERIC" mask="#,###,###" />
			<field row="178" col="250" type="NUMERIC" mask="#,###,###" />
