		<field row="230" col="465" type="STRING">S. Fisico</field>
		<field row="230" col="530" type="STRING">Diferencia</field>
		
		<!-- Pie de pagina -->
		<field row="753" col="20" type="STRING">Berceli Medina - Nit. 79.719.543-2 - Kra. 6 # 13-87 - Tel. 7733324</field>
	</metadata>
	<newpage>
		<font row="0" col="0" name="Sans" size="16" />
		<field row="80" col="240" type="STRING">AJUSTE DE INVENTARIOS</field>
		<image row="30" col="25" width="100" height="75">/icons/logo_fac.png</image>
		<generateBarCodeImage row="135" col="380" />
		<field row="80" col="440" type="STRING">PAGINA:</field>
		<pagenumber row="80" col="530" />
		<font row="0" col="0" name="Sans" size="7" />
		<roundedRectangle row="140" col="20" width="565" height="620" />

		<line row="156" col="20" row2="156" col2="585" />
		<line row="140" col="97" row2="760" col2="97" />
		<line row="140" col="145" row2="760" col2="145" />
